# TUDO AQUI E OPCIONAL. O modo gratis funciona sem preencher nada.
# Para usar, copie este arquivo para .env e remova o # da linha desejada.

# Chave gratuita do eulerstream.com: aumenta o limite do modo gratis (se o limite acabar).
# EULER_API_KEY=

# Somente se voce quiser usar o provedor TikTools:
# TIKTOOLS_API_KEY=

# Porta do app TikFinity (padrao dele) e porta desta roleta:
# TIKFINITY_URL=ws://127.0.0.1:21213/
# PORT=3210
